APP_NAME="OBE System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8888

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PROD: đặt các giá trị thật (xem DEPLOY.md) — APP_ENV=production, APP_DEBUG=false, APP_URL=https://...
# Reverse proxy: '*' tin mọi proxy nội bộ (hoặc IP proxy cụ thể).
TRUSTED_PROXIES=*
# Mật khẩu mặc định khi db:seed (dev='password'); PROD đặt chuỗi mạnh nếu buộc phải seed.
SEED_DEFAULT_PASSWORD=password

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Matches the `db` service in docker-compose.yml (PostgreSQL 16).
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=obe_system
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PROD (HTTPS): đặt true để cookie chỉ gửi qua https.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Giữ log — dọn tự động bởi scheduler (model:prune). Xem config/obe.php.
AUDIT_LOG_KEEP_DAYS=730
MEASUREMENT_RUN_KEEP_DAYS=180

# Cổng host publish Postgres ra máy dev (đổi khi 5432 đã bị chiếm)
DB_PORT_HOST=5432
