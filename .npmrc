ignore-scripts=true
audit=true
# laravel-vite-plugin@3.1 requires vite 8 while @vitejs/plugin-react@4.7 declares
# a vite<=7 peer range; the two are functionally compatible (build passes), so we
# relax npm's strict peer resolver to keep `npm install` / `dev.sh setup` working.
legacy-peer-deps=true
